# Database Configuration
POSTGRES_DB=f1
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1

# Cloudflare Zero Trust Tunnel Token
# Lấy token từ Cloudflare Zero Trust Dashboard: Networks -> Tunnels -> Create a tunnel -> Docker
TUNNEL_TOKEN=

# Backend URL cho Frontend Nginx Proxy (mặc định trỏ tới container backend:8080)
BACKEND_URL=http://backend:8080

