<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.1" metadata-complete="true">
    <display-name>Sponsor Management</display-name>
    <filter><filter-name>session</filter-name><filter-class>com.ngtukien.demo.web.SessionFilter</filter-class></filter>
    <filter-mapping><filter-name>session</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
    <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
</web-app>