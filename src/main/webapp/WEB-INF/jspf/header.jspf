<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Sponsor Management</title>
    <link rel="stylesheet" href="<c:url value='/assets/style.css'/>">
</head>
<body><main>
<c:if test="${not empty sessionScope.member}">
    <nav>
        <span><c:out value="${sessionScope.member.displayName}"/></span>
        <c:choose>
            <c:when test="${not empty sessionScope.organizer}"><a href="<c:url value='/organizer/organizer-home.jsp'/>">Home</a></c:when>
            <c:otherwise><a href="<c:url value='/sponsor/profile.jsp'/>">Profile</a></c:otherwise>
        </c:choose>
        <form action="<c:url value='/do-logout.jsp'/>" method="post">
            <input type="hidden" name="csrf" value="${sessionScope.csrf}"><button>Sign Out</button>
        </form>
    </nav>
</c:if>
<c:if test="${not empty sessionScope.message}">
    <p class="notice"><c:out value="${sessionScope.message}"/></p>
    <c:remove var="message" scope="session"/>
</c:if>
<c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if>